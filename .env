OPENROUTER_API_KEY=your_openrouter_api_key_here

# Custom/Local API
CUSTOM_API_KEY=optional_key_here
CUSTOM_API_URL=http://localhost:8000

# API Configuration
API_ENVIRONMENT=development  # development, staging, production
API_DEBUG=true

# Cost Tracking
COST_ALERT_EMAIL=riyaindap2000@student.sfit.ac.in
COST_WARN_THRESHOLD=10.0
COST_HARD_LIMIT=100.0

# Monitoring
LOG_LEVEL=INFO

# Feature Flags
ENABLE_CACHING=true
ENABLE_RATE_LIMITING=true
ENABLE_COST_TRACKING=true