# Anthropic API
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_TIER=tier_1  # or tier_2

# OpenAI API
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx
OPENAI_ORG_ID=org-xxxxxxxxxxxxxxxxxxxxx

# Custom/Local API
CUSTOM_API_KEY=optional_key_here
CUSTOM_API_URL=http://localhost:8000

# API Configuration
API_ENVIRONMENT=production  # development, staging, production
API_DEBUG=false

# Cost Tracking
COST_ALERT_EMAIL=your-email@example.com
COST_WARN_THRESHOLD=10.0
COST_HARD_LIMIT=100.0

# Monitoring
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx  # Optional
LOG_LEVEL=INFO

# Feature Flags
ENABLE_CACHING=true
ENABLE_RATE_LIMITING=true
ENABLE_COST_TRACKING=true